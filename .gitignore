data/*
artifacts/*
**/__pycache__/**
assets/
paper/
.venv/

# Card sets and audited labels ARE version-controlled: they are the artifact the paper reports on,
# and losing them means losing the experiment. Bulk corpora and derived splits stay out of git.
!data/rules/
data/rules/*
!data/rules/mbg_cards.jsonl
!data/rules/mbg_cards_qwen38_full.jsonl
!data/rules/mbg_cards_app.jsonl
!data/rules/mbg_cards_repaired.jsonl
!data/rules/mbg_cards_recompiled.jsonl
!data/rules/mbg_cards_triaged.jsonl
!data/rules/mbg_cards_precise.jsonl
!data/rules/mbg_cards_precise_app.jsonl
# every card set generation is evidence (cond* = source-conditional line, mined = corpus-mined cards)
!data/rules/mbg_cards_*.jsonl
# the specs that drive apply_source_conditionals / screen_source_conditionals, and the reliability tables
!data/rules/source_conditionals*.json
!data/rules/screened_conditionals.json
!data/rules/reliability*.json
!data/external/
data/external/*
!data/external/MANIFEST.json
!data/processed/
data/processed/*
# audited labels below are 100% CC0-1.0 (Tech-in-GOV), so they are safe to publish;
# rows carrying CC BY-NC material stay out of the repo and are reproducible via MANIFEST + ingest.
# Verified 2026-11-27: every data/processed/labeled_*.jsonl carries license CC0-1.0 on 100% of rows.
!data/processed/labeled_*.jsonl

# generated per-namespace workspace configs (only configs/project/ is authored)
grammetarl/configs/*/
!grammetarl/configs/project/

# audit/recompile evidence: small JSON, it is what the paper claims rest on
!artifacts/audit/
artifacts/audit/*
!artifacts/audit/precision_*.json
!artifacts/recompile/
artifacts/recompile/*
!artifacts/recompile/report.json

!data/rules/mbg_cards_precise_app.jsonl

!data/rules/manual_triggers.json
!data/processed/labeled_gated.jsonl

!data/rules/mbg_cards_recompiled_manual.jsonl

!artifacts/audit/trigger_quality*.json
!data/processed/tagged_judged_direct.jsonl

# three-axis rule quality, source-conditional audits, violation decomposition, P1 reward smoke:
# these are the evidence files the paper's numbers are read from, so they are version-controlled.
!artifacts/audit/rule_quality_*.json
!artifacts/audit/condonly*.json
!artifacts/audit/condv*_fit.json
!artifacts/audit/screen_conditionals_*.json
!artifacts/audit/gated_cond*.json
!artifacts/audit/gated_condonly*.json
!artifacts/audit/violations_*.json
!artifacts/p1/
artifacts/p1/*
!artifacts/p1/*.json
